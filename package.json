{
  "name": "harness-agent-eve-extension",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/harness-agent-eve-extension"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "eve extension build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "eve extension build",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-sdk/harness": "^1.0.87",
    "@ai-sdk/harness-acp": "^1.0.25",
    "@ai-sdk/harness-claude-code": "^1.0.90",
    "@ai-sdk/harness-cline": "^1.0.14",
    "@ai-sdk/harness-codex": "^1.0.89",
    "@ai-sdk/harness-cursor": "^1.0.0",
    "@ai-sdk/harness-deepagents": "^1.0.87",
    "@ai-sdk/harness-fx": "^1.0.0",
    "@ai-sdk/harness-grok-build": "^1.0.24",
    "@ai-sdk/harness-opencode": "^1.0.88",
    "@ai-sdk/harness-pi": "^1.0.89",
    "@standard-schema/spec": "^1.1.0",
    "@vercel/sandbox-drives": "npm:@vercel/sandbox@^2.10.0-beta.0",
    "ai": "^7.0.79",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@felixarntz/biome": "^0.2.0",
    "@types/node": "24.x",
    "eve": "0.44.4",
    "typescript": "7.0.2",
    "ultracite": "^7"
  },
  "peerDependencies": {
    "eve": "*"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension",
      "externalDependencies": [
        "@ai-sdk/harness-acp",
        "@ai-sdk/harness-claude-code",
        "@ai-sdk/harness-codex",
        "@ai-sdk/harness-deepagents",
        "@ai-sdk/harness-opencode"
      ]
    }
  }
}
